#!/usr/bin/env bash
# Bloqueia commit de arquivos .env em texto puro.
# - .env / .env.<nome>      -> sempre bloqueado
# - .env.<nome>.enc         -> só passa se estiver criptografado pelo SOPS
set -euo pipefail

fail=0
while IFS= read -r f; do
  base="$(basename "$f")"
  case "$base" in
    .env.*.enc)
      if ! git show ":$f" | grep -q '^sops_mac=ENC\['; then
        echo "BLOQUEADO: $f não está criptografado pelo SOPS." >&2
        fail=1
      fi
      ;;
    .env|.env.*)
      echo "BLOQUEADO: $f é um .env em texto puro. Use: scripts/secrets.sh encrypt" >&2
      fail=1
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

exit $fail
