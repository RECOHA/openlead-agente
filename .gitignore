# ─── Segredos ────────────────────────────────────────────────────
# Arquivos .env em texto puro NUNCA são versionados.
# Versione apenas a cópia criptografada com SOPS: .env.<nome>.enc
# (gere com: scripts/secrets.sh encrypt)
.env
.env.*
!.env.*.enc

# Outros segredos (chaves SSH, certificados...) ficam em secrets/
# e também só entram no git criptografados: secrets/<nome>.enc
secrets/*
!secrets/*.enc

# Chaves privadas do age (nunca versionar)
keys.txt
*.agekey
